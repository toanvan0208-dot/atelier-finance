generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DataMode {
  sample
  demo
  user_input
  research_only
  production_approved
  blocked
  unknown
}

enum SourceType {
  official
  exchange
  licensed_vendor
  company_disclosure
  curated_internal
  user_input
  unknown
}

enum SourceUsageStatus {
  approved
  needs_legal_review
  blocked
  research_only
  unknown
}

enum LegalReviewStatus {
  not_checked
  needs_review
  approved
  rejected
}

enum SourceAccessMethod {
  official_api
  official_download
  licensed_feed
  public_file
  public_web
  manual_fixture
  manual_upload
  scraping
  scraped
  private_api
  undocumented_api
  private_or_undocumented_api
  unknown
}

enum SourceEvidenceStatus {
  verified
  partially_verified
  missing
  conflicting
}

enum PermissionFlag {
  true
  false
  unknown
}

enum CompanyType {
  non_financial
  bank
  securities
  insurance
  unknown
}

enum PeriodType {
  session
  day
  month
  quarter
  year
  ttm
  manual
  unknown
}

enum ReadinessStatus {
  ready
  needs_review
  not_ready
  insufficient_data
  unknown
}

enum QualityStatus {
  good
  usable_with_caution
  partial
  missing
  stale
  sample
  demo
  user_input
  blocked
  unknown
}

enum ManualImportStatus {
  draft
  validated
  needs_review
  failed
  persisted
}

enum PaperTradeAction {
  open_position
  close_position
  observe_position
}

enum PaperTradeStatus {
  planned
  open
  closed
  cancelled
}

model User {
  id                    String                 @id @default(cuid())
  email                 String?                @unique
  passwordHash          String?
  displayName           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  authSessions          AuthSession[]
  passwordResetTokens   PasswordResetToken[]
  manualImportSessions  ManualImportSession[]
  simulationProfile     SimulationProfile?
  simulationScenarios   SimulationScenario[]
  simulationJournals    SimulationJournal[]
  watchlists            Watchlist[]
  paperTrades           PaperTrade[]
  assistantInteractions AssistantInteraction[]
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id                    String                   @id @default(cuid())
  ticker                String
  exchange              String?
  companyName           String
  companyType           CompanyType              @default(unknown)
  industryCode          String?
  industryName          String?
  country               String?
  currency              String?
  dataMode              DataMode                 @default(unknown)
  profileSourceId       String?
  profileAsOf           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  profileSource         DataSource?              @relation("CompanyProfileSource", fields: [profileSourceId], references: [id])
  financialStatements   FinancialStatement[]
  marketPrices          MarketPrice[]
  manualImportRecords   ManualImportRecord[]
  watchlists            Watchlist[]
  paperTrades           PaperTrade[]
  simulationScenarios   SimulationScenario[]
  simulationJournals    SimulationJournal[]
  assistantInteractions AssistantInteraction[]
  businessProfiles      CompanyBusinessProfile[]

  @@unique([ticker, exchange])
  @@index([ticker])
  @@index([companyType])
  @@index([dataMode])
}

model FinancialStatement {
  id                  String                           @id @default(cuid())
  companyId           String
  ticker              String
  companyType         CompanyType                      @default(unknown)
  periodType          PeriodType
  period              String
  fiscalYear          Int?
  fiscalQuarter       Int?
  reportDate          DateTime?
  publishedDate       DateTime?
  currency            String?
  unit                String?
  revenue             Decimal?
  grossProfit         Decimal?
  netIncome           Decimal?
  operatingCashFlow   Decimal?
  totalAssets         Decimal?
  equity              Decimal?
  totalDebt           Decimal?
  currentAssets       Decimal?
  currentLiabilities  Decimal?
  eps                 Decimal?
  bvps                Decimal?
  sharesOutstanding   Decimal?
  marketCap           Decimal?
  enterpriseValue     Decimal?
  sourceId            String
  sourceLabel         String
  sourceType          SourceType
  dataMode            DataMode
  asOf                DateTime
  collectedAt         DateTime?
  qualityStatus       QualityStatus                    @default(unknown)
  readiness           ReadinessStatus                  @default(unknown)
  missingFields       String                           @default("[]")
  warningCodes        String                           @default("[]")
  errorCodes          String                           @default("[]")
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  company             Company                          @relation(fields: [companyId], references: [id])
  source              DataSource                       @relation(fields: [sourceId], references: [id])
  manualImportRecords ManualImportRecord[]
  unitMetadata        FinancialStatementUnitMetadata[]

  @@index([companyId, period])
  @@index([ticker, period])
  @@index([sourceId, asOf])
  @@index([dataMode])
  @@index([readiness])
}

model FinancialStatementUnitMetadata {
  id                   String             @id @default(cuid())
  financialStatementId String
  field                String
  unit                 String
  status               String
  sourceLabel          String?
  dataMode             String             @default("research_only")
  warningCodes         String             @default("[]")
  productionApproved   Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  financialStatement   FinancialStatement @relation(fields: [financialStatementId], references: [id], onDelete: Cascade)

  @@unique([financialStatementId, field])
  @@index([financialStatementId])
  @@index([field])
}

model MarketPrice {
  id                  String                    @id @default(cuid())
  companyId           String
  ticker              String
  tradingDate         DateTime
  periodType          PeriodType                @default(day)
  period              String
  openPrice           Decimal?
  highPrice           Decimal?
  lowPrice            Decimal?
  closePrice          Decimal?
  previousClose       Decimal?
  adjustedClosePrice  Decimal?
  volume              Decimal?
  tradingValue        Decimal?
  marketCap           Decimal?
  currency            String?
  sourceId            String
  sourceLabel         String
  sourceType          SourceType
  dataMode            DataMode
  asOf                DateTime
  collectedAt         DateTime?
  qualityStatus       QualityStatus             @default(unknown)
  readiness           ReadinessStatus           @default(unknown)
  missingFields       String                    @default("[]")
  warningCodes        String                    @default("[]")
  errorCodes          String                    @default("[]")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  company             Company                   @relation(fields: [companyId], references: [id])
  source              DataSource                @relation(fields: [sourceId], references: [id])
  manualImportRecords ManualImportRecord[]
  unitMetadata        MarketPriceUnitMetadata[]

  @@index([companyId, tradingDate])
  @@index([ticker, tradingDate])
  @@index([sourceId, asOf])
  @@index([dataMode])
  @@index([readiness])
}

model MarketPriceUnitMetadata {
  id                 String      @id @default(cuid())
  marketPriceId      String
  field              String
  unit               String
  status             String
  source             String?
  sourceLabel        String?
  dataMode           String?
  asOf               DateTime?
  warningCodes       String      @default("[]")
  productionApproved Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  marketPrice        MarketPrice @relation(fields: [marketPriceId], references: [id], onDelete: Cascade)

  @@unique([marketPriceId, field])
  @@index([marketPriceId])
  @@index([field])
  @@index([status])
}

model DataSource {
  id                      String                   @id @default(cuid())
  name                    String
  sourceType              SourceType
  supportedDataGroups     String                   @default("[]")
  usageStatus             SourceUsageStatus        @default(unknown)
  licenseStatus           LegalReviewStatus        @default(not_checked)
  tosStatus               LegalReviewStatus        @default(not_checked)
  accessMethod            SourceAccessMethod       @default(unknown)
  cachingAllowed          PermissionFlag           @default(unknown)
  redistributionAllowed   PermissionFlag           @default(unknown)
  runtimeDisplayAllowed   PermissionFlag           @default(unknown)
  derivedDataAllowed      PermissionFlag           @default(unknown)
  attributionText         String?
  notes                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  profileCompanies        Company[]                @relation("CompanyProfileSource")
  financialStatements     FinancialStatement[]
  marketPrices            MarketPrice[]
  marketIndexObservations MarketIndexObservation[]
  sourceEvidence          SourceEvidence[]

  @@unique([name, sourceType])
  @@index([usageStatus])
  @@index([sourceType])
}

model SourceEvidence {
  id                   String               @id @default(cuid())
  sourceId             String
  homepageUrl          String?
  documentationUrl     String?
  licenseName          String?
  licenseUrl           String?
  termsUrl             String?
  allowsPersonalUse    PermissionFlag       @default(unknown)
  allowsAcademicUse    PermissionFlag       @default(unknown)
  allowsCommercialUse  PermissionFlag       @default(unknown)
  allowsRuntimeDisplay PermissionFlag       @default(unknown)
  allowsCaching        PermissionFlag       @default(unknown)
  allowsRedistribution PermissionFlag       @default(unknown)
  allowsDerivedData    PermissionFlag       @default(unknown)
  requiresAttribution  PermissionFlag       @default(unknown)
  evidenceStatus       SourceEvidenceStatus @default(missing)
  reviewedAt           DateTime?
  reviewedBy           String?
  reviewNote           String?
  notes                String?
  risks                String               @default("[]")
  blockedReason        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  source               DataSource           @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([evidenceStatus])
}

model DataQualityReport {
  id                   String                @id @default(cuid())
  scopeType            String
  scopeId              String?
  status               String
  readiness            ReadinessStatus       @default(unknown)
  qualityStatus        QualityStatus         @default(unknown)
  missingFields        String                @default("[]")
  warningCodes         String                @default("[]")
  errorCodes           String                @default("[]")
  topIssues            String                @default("[]")
  fieldCoverage        String                @default("[]")
  safeNextSteps        String                @default("[]")
  generatedAt          DateTime              @default(now())
  calculationVersion   String?
  manualImportSessions ManualImportSession[]

  @@index([scopeType, scopeId])
  @@index([readiness])
  @@index([qualityStatus])
}

model ManualImportSession {
  id                  String               @id @default(cuid())
  userId              String?
  mode                String               @default("thesis_verification")
  sourceLabel         String               @default("manual_upload")
  sourceType          SourceType           @default(user_input)
  dataMode            DataMode             @default(user_input)
  targetTicker        String?
  targetPeriod        String?
  fileName            String?
  rowCount            Int                  @default(0)
  validRowCount       Int                  @default(0)
  warningRowCount     Int                  @default(0)
  errorRowCount       Int                  @default(0)
  status              ManualImportStatus   @default(draft)
  readiness           ReadinessStatus      @default(unknown)
  dataQualityReportId String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User?                @relation(fields: [userId], references: [id])
  dataQualityReport   DataQualityReport?   @relation(fields: [dataQualityReportId], references: [id])
  records             ManualImportRecord[]

  @@index([userId, createdAt])
  @@index([dataMode])
  @@index([status])
  @@index([readiness])
}

model ManualImportRecord {
  id                   String              @id @default(cuid())
  sessionId            String
  rowIndex             Int
  rawPayload           String              @default("{}")
  normalizedPayload    String              @default("{}")
  ticker               String?
  period               String?
  periodType           PeriodType          @default(unknown)
  asOf                 DateTime?
  sourceLabel          String              @default("manual_upload")
  sourceType           SourceType          @default(user_input)
  dataMode             DataMode            @default(user_input)
  readiness            ReadinessStatus     @default(unknown)
  qualityStatus        QualityStatus       @default(user_input)
  warnings             String              @default("[]")
  errors               String              @default("[]")
  warningCodes         String              @default("[]")
  errorCodes           String              @default("[]")
  unmappedFields       String              @default("[]")
  missingFields        String              @default("[]")
  companyId            String?
  financialStatementId String?
  marketPriceId        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  session              ManualImportSession @relation(fields: [sessionId], references: [id])
  company              Company?            @relation(fields: [companyId], references: [id])
  financialStatement   FinancialStatement? @relation(fields: [financialStatementId], references: [id])
  marketPrice          MarketPrice?        @relation(fields: [marketPriceId], references: [id])

  @@unique([sessionId, rowIndex])
  @@index([ticker, period])
  @@index([dataMode])
  @@index([readiness])
}

model Watchlist {
  id            String          @id @default(cuid())
  userId        String?
  companyId     String
  ticker        String
  status        String          @default("watching")
  priority      String?
  notes         String?
  thesisSummary String?
  dataMode      DataMode        @default(unknown)
  readiness     ReadinessStatus @default(unknown)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User?           @relation(fields: [userId], references: [id])
  company       Company         @relation(fields: [companyId], references: [id])

  @@index([userId, status])
  @@index([companyId])
  @@index([dataMode])
}

model PaperTrade {
  id             String               @id @default(cuid())
  userId         String?
  companyId      String
  ticker         String
  action         PaperTradeAction
  quantity       Decimal?
  entryPrice     Decimal?
  exitPrice      Decimal?
  openedAt       DateTime?
  closedAt       DateTime?
  status         PaperTradeStatus     @default(planned)
  thesisSnapshot String?
  reflection     String?
  sourceMode     DataMode             @default(unknown)
  readiness      ReadinessStatus      @default(unknown)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User?                @relation(fields: [userId], references: [id])
  company        Company              @relation(fields: [companyId], references: [id])
  scenarios      SimulationScenario[]
  journals       SimulationJournal[]

  @@index([userId, status])
  @@index([companyId])
  @@index([sourceMode])
}

model SimulationProfile {
  id                String          @id @default(cuid())
  userId            String          @unique
  totalCapital      Decimal?
  cash              Decimal?
  riskBudgetPercent Decimal?
  notes             String?
  dataMode          DataMode        @default(user_input)
  readiness         ReadinessStatus @default(needs_review)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dataMode])
  @@index([readiness])
}

model SimulationScenario {
  id                          String          @id @default(cuid())
  userId                      String
  paperTradeId                String?
  companyId                   String?
  ticker                      String?
  scenarioType                String          @default("base")
  title                       String
  condition                   String?
  signalsToWatch              String          @default("[]")
  impactOnPosition            String?
  suggestedSimulationResponse String?
  relatedModules              String          @default("[]")
  status                      String          @default("active")
  dataMode                    DataMode        @default(user_input)
  readiness                   ReadinessStatus @default(needs_review)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  user                        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperTrade                  PaperTrade?     @relation(fields: [paperTradeId], references: [id], onDelete: SetNull)
  company                     Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([paperTradeId])
  @@index([companyId])
  @@index([ticker])
  @@index([dataMode])
}

model SimulationJournal {
  id           String          @id @default(cuid())
  userId       String
  paperTradeId String?
  companyId    String?
  ticker       String?
  eventType    String
  title        String
  content      String?
  metadata     String          @default("{}")
  dataMode     DataMode        @default(user_input)
  readiness    ReadinessStatus @default(needs_review)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperTrade   PaperTrade?     @relation(fields: [paperTradeId], references: [id], onDelete: SetNull)
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([paperTradeId])
  @@index([companyId])
  @@index([ticker])
  @@index([eventType])
}

model AssistantInteraction {
  id                   String          @id @default(cuid())
  userId               String?
  companyId            String?
  activeModule         String          @default("overview")
  ticker               String?
  question             String
  answer               String?
  provider             String?
  llmStatus            String?
  moduleContext        String          @default("{}")
  dataQualityContext   String          @default("{}")
  allowedNumericValues String          @default("[]")
  source               String?
  sourceMode           DataMode        @default(unknown)
  readiness            ReadinessStatus @default(unknown)
  createdAt            DateTime        @default(now())
  user                 User?           @relation(fields: [userId], references: [id])
  company              Company?        @relation(fields: [companyId], references: [id])

  @@index([userId, createdAt])
  @@index([ticker, activeModule])
  @@index([sourceMode])
}

model CompanyBusinessProfile {
  id                   String    @id @default(uuid())
  ticker               String
  companyId            String?
  businessDescription  String?
  businessModelSummary String?
  mainProducts         String?
  revenueDrivers       String?
  businessRiskNotes    String?
  profileLanguage      String    @default("vi")
  asOfDate             DateTime?
  sourceLabel          String
  dataMode             DataMode
  productionApproved   Boolean   @default(false)
  needsReview          Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([ticker, sourceLabel, profileLanguage])
  @@index([ticker])
  @@index([sourceLabel])
}

model MacroContext {
  id                  String   @id @default(uuid())
  asOfDate            DateTime
  contextLanguage     String   @default("vi")
  gdpGrowthContext    String?
  inflationContext    String?
  interestRateContext String?
  exchangeRateContext String?
  marketContext       String?
  sourceLabel         String
  dataMode            String   @default("research_only")
  productionApproved  Boolean  @default(false)
  needsReview         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([asOfDate, sourceLabel, contextLanguage])
}

model IndustryContext {
  id                    String   @id @default(uuid())
  industryCode          String?
  industryName          String
  contextLanguage       String   @default("vi")
  industryOverview      String?
  howIndustryMakesMoney String?
  keyDrivers            String?
  industryRisks         String?
  macroSensitivity      String?
  nextChecks            String?
  commonMisread         String?
  relatedTickers        String[]
  asOfDate              DateTime
  sourceLabel           String
  dataMode              String   @default("research_only")
  productionApproved    Boolean  @default(false)
  needsReview           Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  provenanceRows IndustryContextProvenance[]

  @@unique([industryName, asOfDate, sourceLabel, contextLanguage])
}

model Industry {
  id                   String   @id @default(cuid())
  industryCode         String   @unique
  industryName         String
  displayNameVi        String
  sectorCode           String?
  sectorName           String?
  classificationSystem String
  description          String?
  dataMode             String   @default("research_only")
  productionApproved   Boolean  @default(false)
  needsReview          Boolean  @default(true)
  warningCodes         String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  companyMappings CompanyIndustry[]
  peerGroups      IndustryPeerGroup[]
  metrics         IndustryMetric[]

  @@index([sectorCode])
  @@index([classificationSystem])
  @@index([dataMode])
  @@index([productionApproved])
}

model CompanyIndustry {
  id                 String    @id @default(cuid())
  ticker             String
  industryCode       String
  roleType           String    @default("ambiguous")
  segmentDescription String?
  mappingConfidence  String    @default("missing")
  sourceLabel        String
  sourceUrl          String
  sourceType         String
  publicationDate    DateTime?
  retrievedAt        DateTime?
  reviewNote         String?
  extractedQuote     String?
  warningCodes       String    @default("[]")
  dataMode           String    @default("research_only")
  productionApproved Boolean   @default(false)
  needsReview        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  industry Industry @relation(fields: [industryCode], references: [industryCode])

  @@unique([ticker, industryCode, roleType, sourceLabel, sourceUrl])
  @@index([ticker])
  @@index([industryCode])
  @@index([roleType])
  @@index([dataMode])
  @@index([productionApproved])
}

model IndustryPeerGroup {
  id                 String    @id @default(cuid())
  industryCode       String
  peerTicker         String
  peerRole           String    @default("ambiguous")
  inclusionReason    String
  sourceLabel        String
  sourceUrl          String
  sourceType         String
  publicationDate    DateTime?
  retrievedAt        DateTime?
  reviewNote         String?
  extractedQuote     String?
  warningCodes       String    @default("[]")
  dataMode           String    @default("research_only")
  productionApproved Boolean   @default(false)
  needsReview        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  industry Industry @relation(fields: [industryCode], references: [industryCode])

  @@unique([industryCode, peerTicker, peerRole, sourceLabel, sourceUrl])
  @@index([industryCode])
  @@index([peerTicker])
  @@index([peerRole])
  @@index([dataMode])
  @@index([productionApproved])
}

model IndustryMetric {
  id                 String    @id @default(cuid())
  industryCode       String
  metricCode         String
  metricName         String
  metricLabelVi      String
  metricGroup        String
  value              Decimal?
  unit               String
  periodType         String
  periodLabel        String
  observationDate    DateTime
  sourceLabel        String
  sourceUrl          String?
  sourceKey          String
  dataMode           String    @default("research_only")
  productionApproved Boolean   @default(false)
  needsReview        Boolean   @default(true)
  qualityStatus      String    @default("needs_review")
  missingReason      String?
  warningCodes       String    @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  industry       Industry                   @relation(fields: [industryCode], references: [industryCode])
  provenanceRows IndustryMetricProvenance[]

  @@unique([industryCode, metricCode, observationDate, sourceKey])
  @@index([industryCode])
  @@index([metricCode])
  @@index([observationDate])
  @@index([dataMode])
  @@index([productionApproved])
  @@index([needsReview])
}

model IndustryMetricProvenance {
  id                 String    @id @default(cuid())
  industryMetricId   String
  industryCode       String
  metricCode         String
  observationDate    DateTime
  sourceLabel        String
  sourceUrl          String?
  sourceKey          String
  sourceType         String
  publicationDate    DateTime?
  retrievedAt        DateTime?
  dataMode           String    @default("research_only")
  productionApproved Boolean   @default(false)
  needsReview        Boolean   @default(true)
  payloadChecksum    String?
  evidenceNotes      String?
  warningCodes       String    @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  industryMetric IndustryMetric @relation(fields: [industryMetricId], references: [id])

  @@unique([industryMetricId, sourceKey])
  @@index([industryMetricId])
  @@index([industryCode])
  @@index([metricCode])
  @@index([observationDate])
  @@index([sourceLabel])
  @@index([sourceKey])
  @@index([dataMode])
  @@index([productionApproved])
}

model IndustryContextProvenance {
  id                 String    @id @default(cuid())
  industryContextId  String
  ticker             String
  industryName       String
  sourceLabel        String
  sourceUrl          String
  sourceType         String
  dataMode           String    @default("research_only")
  productionApproved Boolean   @default(false)
  needsReview        Boolean   @default(true)
  publicationDate    DateTime?
  retrievedAt        DateTime?
  extractedQuote     String?
  reviewNote         String?
  warningCodes       String    @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  industryContext IndustryContext @relation(fields: [industryContextId], references: [id])

  @@unique([industryContextId, ticker, sourceLabel, sourceUrl])
  @@index([industryContextId])
  @@index([ticker])
  @@index([sourceLabel])
  @@index([dataMode])
  @@index([productionApproved])
}

model MarketPriceProvenanceMetadata {
  id                 String    @id @default(cuid())
  ticker             String
  marketDate         DateTime
  providerName       String
  providerType       String
  sourceLabel        String
  dataMode           String
  productionApproved Boolean   @default(false)
  fetchedAt          DateTime?
  exchange           String?
  currency           String?
  priceUnit          String?
  volumeUnit         String?
  adjustmentStatus   String
  stalenessStatus    String
  fallbackUsed       Boolean   @default(false)
  needsReview        Boolean   @default(true)
  importRunId        String?
  payloadChecksum    String?
  warningCodes       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([ticker, marketDate, sourceLabel])
  @@index([ticker])
  @@index([marketDate])
  @@index([sourceLabel])
  @@index([dataMode])
  @@index([productionApproved])
  @@index([stalenessStatus])
  @@index([adjustmentStatus])
}

model ScreeningCandidate {
  id                 String   @id @default(cuid())
  ticker             String
  companyName        String?
  industryCode       String?
  peerRole           String?
  coverageLevel      String
  screeningEligible  Boolean  @default(true)
  analysisEligible   Boolean  @default(false)
  dataMode           String   @default("research_only")
  needsReview        Boolean  @default(true)
  productionApproved Boolean  @default(false)
  warningCodes       String   @default("[]")
  caveats            String   @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  metrics        ScreeningCandidateMetric[]
  provenanceRows ScreeningCandidateProvenance[]

  @@unique([ticker])
  @@index([coverageLevel])
  @@index([screeningEligible])
  @@index([analysisEligible])
  @@index([dataMode])
  @@index([needsReview])
  @@index([productionApproved])
}

model ScreeningCandidateMetric {
  id                 String    @id @default(cuid())
  candidateId        String
  ticker             String
  metricCode         String
  value              Decimal?
  unit               String?
  period             String?
  periodType         String?
  providerPeriod     String?
  snapshotDate       DateTime?
  fiscalYearEnd      DateTime?
  statementScope     String?
  sourceType         String?
  sourceLabel        String?
  sourceUrl          String?
  extractedQuote     String?
  reviewNote         String?
  warningCodes       String    @default("[]")
  dataMode           String    @default("research_only")
  needsReview        Boolean   @default(true)
  productionApproved Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  candidate      ScreeningCandidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  provenanceRows ScreeningCandidateProvenance[]

  @@unique([candidateId, metricCode])
  @@index([ticker])
  @@index([metricCode])
  @@index([dataMode])
  @@index([needsReview])
  @@index([productionApproved])
}

model ScreeningCandidateProvenance {
  id                 String    @id @default(cuid())
  candidateId        String
  metricId           String?
  ticker             String
  metricCode         String?
  sourceType         String
  sourceLabel        String
  sourceUrl          String?
  retrievedAt        DateTime?
  publicationDate    DateTime?
  extractedQuote     String?
  reviewNote         String?
  payloadChecksum    String?
  warningCodes       String    @default("[]")
  dataMode           String    @default("research_only")
  needsReview        Boolean   @default(true)
  productionApproved Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  candidate ScreeningCandidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  metric    ScreeningCandidateMetric? @relation(fields: [metricId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([metricId])
  @@index([ticker])
  @@index([metricCode])
  @@index([sourceLabel])
  @@index([sourceType])
  @@index([dataMode])
  @@index([needsReview])
  @@index([productionApproved])
}

model MacroIndicator {
  id               String             @id @default(cuid())
  indicatorCode    String             @unique
  indicatorName    String
  description      String?
  category         String?
  defaultUnit      String?
  defaultFrequency String?
  regionScope      String?
  sourceLabel      String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  observations     MacroObservation[]
}

model MacroObservation {
  id                 String   @id @default(cuid())
  indicatorId        String
  indicatorCode      String
  region             String
  observationDate    DateTime
  value              Decimal?
  unit               String?
  frequency          String?
  periodLabel        String?
  sourceLabel        String
  dataMode           String
  productionApproved Boolean  @default(false)
  needsReview        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  indicator MacroIndicator @relation(fields: [indicatorId], references: [id])

  @@unique([indicatorCode, region, observationDate, sourceLabel])
  @@index([indicatorId])
  @@index([indicatorCode])
  @@index([region])
  @@index([observationDate])
  @@index([sourceLabel])
  @@index([dataMode])
}

model MacroObservationProvenance {
  id                 String    @id @default(cuid())
  indicatorCode      String
  region             String
  observationDate    DateTime
  sourceLabel        String
  providerType       String
  dataMode           String
  productionApproved Boolean   @default(false)
  needsReview        Boolean   @default(true)
  sourceUrl          String?
  retrievedAt        DateTime?
  publishedAt        DateTime?
  payloadChecksum    String?
  rawPayloadSnippet  String?
  warningCodes       String?
  evidenceNotes      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([indicatorCode, region, observationDate, sourceLabel])
  @@index([indicatorCode])
  @@index([region])
  @@index([observationDate])
  @@index([sourceLabel])
  @@index([dataMode])
}

model MarketIndexObservation {
  id                 String     @id @default(cuid())
  symbol             String
  indexName          String?
  tradingDate        DateTime
  openPoint          Decimal?
  highPoint          Decimal?
  lowPoint           Decimal?
  closePoint         Decimal
  pointUnit          String
  volume             BigInt?
  volumeUnit         String?
  sourceId           String
  sourceLabel        String
  sourceType         SourceType
  dataMode           DataMode
  needsReview        Boolean    @default(true)
  productionApproved Boolean    @default(false)
  warningCodes       Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  source             DataSource @relation(fields: [sourceId], references: [id])

  @@unique([symbol, tradingDate, sourceId])
  @@index([symbol, tradingDate])
  @@index([sourceId])
}
